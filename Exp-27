best_first(Start, Goal, Path) :-
    explore([[Start]], Goal, RevPath),
    reverse(RevPath, Path).

explore([[Goal|Rest]|_], Goal, [Goal|Rest]).
explore([[Current|Rest]|Queue], Goal, Path) :-
    findall([Next, Current|Rest], (edge(Current, Next, _), \+ member(Next, [Current|Rest])), Children),
    append(Queue, Children, NewQueue),
    % Assume sort_by_heuristic/2 sorts paths based on heuristic value of head node
    sort_by_heuristic(NewQueue, SortedQueue),
    explore(SortedQueue, Goal, Path).
