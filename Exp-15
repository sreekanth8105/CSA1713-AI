
def alphabeta(depth, node, maximizing, alpha, beta):
    if depth == 3:
        return tree[node]

    if maximizing:
        best = float('-inf')

        for i in range(2):
            value = alphabeta(depth + 1, node * 2 + i, False, alpha, beta)
            best = max(best, value)
            alpha = max(alpha, best)

            if beta <= alpha:
                break

        return best

    else:
        best = float('inf')

        for i in range(2):
            value = alphabeta(depth + 1, node * 2 + i, True, alpha, beta)
            best = min(best, value)
            beta = min(beta, best)

            if beta <= alpha:
                break

        return best


tree = [3, 5, 6, 9, 1, 2, 0, -1]

result = alphabeta(0, 0, True, float('-inf'), float('inf'))

print("Optimal value:", result)
