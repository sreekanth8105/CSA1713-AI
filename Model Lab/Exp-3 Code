% Facts
male(john).
male(peter).
male(david).
male(robert).
female(mary).
female(susan).
female(lisa).
female(anna).
% Parent relationships
parent(john, peter).
parent(mary, peter).
parent(john, lisa).
parent(mary, lisa).
parent(peter, david).
parent(susan, david).
parent(peter, anna).
parent(susan, anna).
% Father and Mother
father(X, Y) :- male(X), parent(X, Y).
mother(X, Y) :- female(X), parent(X, Y).
% Brother and Sister
brother(X, Y) :-
    male(X), parent(P, X), parent(P, Y), X \= Y.
sister(X, Y) :-
    female(X), parent(P, X), parent(P, Y), X \= Y.
% Uncle and Aunt
uncle(X, Y) :-
    brother(X, P), parent(P, Y).
aunt(X, Y) :-
    sister(X, P), parent(P, Y).
% Cousin
cousin(X, Y) :-
    parent(P1, X),
    parent(P2, Y),
    brother(P1, P2).
cousin(X, Y) :-
    parent(P1, X),
    parent(P2, Y),
    sister(P1, P2).
