def tsp(graph, start):
    n = len(graph)
    visited = [False] * n
    path = [start]
    visited[start] = True
    cost = 0
    current = start

    for _ in range(n - 1):
        next_city = -1
        min_cost = float('inf')

        for city in range(n):
            if not visited[city] and graph[current][city] < min_cost:
                min_cost = graph[current][city]
                next_city = city

        path.append(next_city)
        visited[next_city] = True
        cost += min_cost
        current = next_city

    cost += graph[current][start]
    path.append(start)

    print("Path:", " -> ".join(map(str, path)))
    print("Total Cost:", cost)


graph = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

tsp(graph, 0)
